 1570IF V%=20 AND (N%=16 OR N%=38) THEN IF FNget(4)=1 AND NOT FNon(17) THEN PROCmsg(98):=TRUE
 1580IF (V%=41 OR V%=36) AND N%=39 THEN IF FNget(4)=1 AND FNon(30) AND NOT FNon(17) THEN PROCon(17):PROCon(33):PROCmsg(209):=TRUE
 1590IF (V%=47 OR V%=33) AND N%=42 THEN IF FNon(33) THEN PROCmsg(215):PROChold(200):PRINT:PROCmsg(218):PRINT:PRINT:R%=48:OLR%=R%:PROCgtRm(R%):=TRUE
 1600IF (V%=47 OR V%=33) AND N%=42 THEN IF NOT FNon(33) THEN PROCmsg(242):=TRUE
 1610IF V%=20 AND (N%=16 OR N%=38) THEN PROCmsg(97):=TRUE
 1620IF (V%=41 OR V%=36) AND N%=39 THEN IF FNget(4)=1 AND FNon(30) AND FNon(17) THEN PROCmsg(219):=TRUE
