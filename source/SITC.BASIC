   10REM > GAME
   20VDU23;8202;0;0;0;
   30T%=0:Q%=0:*KEY 0 *be|MBACK B|MFORE W|MMODE128|M
   40REM DIM AC% 35:ACH%=35:FOR X%=1 TO 35:?(AC%+X%)=0:NEXT:PROCsvAc
   50REPEAT
   60PRINT "Loading data.";:PROCldOb("DATA-O"):PROCldAc("DATA-C")
   70IF T%=0 THEN PROCgW(1):PROCgW(2):PROCgW(4):PROCldSM
   80MODE7:PRINT:PRINTCHR$(131);CHR$(141);TAB(5)"Paranoia - Send in the Clones!":PRINTCHR$(131);CHR$(141);TAB(5)"Paranoia - Send in the Clones!"
   90HIMEM=31700:PROCvars:DIM CTR% 256:FORX%=1TO256:?(CTR%+X%)=0:NEXT
  100OLR%=0:T%=0:PL%=10000:EX%=0:ENC%=0:CW%=0:PROCinit:PROCsc
  110PRINT TAB(0,5)"Press";CHR$(131);"1";CHR$(135);"to start a new game":PRINT TAB(0,7)"Press"CHR$(131);"2";CHR$(135);"to continue an existing game":PRINT:PRINT">";:REPEAT:C$=INKEY$(0):UNTIL C$="1" OR C$="2":CLS:R%=RND(-TIME):R%=1
  120IF C$="2" THEN PRINTTAB(10,0)CHR$(131);"Getting catalogue...":PRINT:*CAT
  130IF C$="2" THEN PRINT:PRINT"Type the file name and press Enter":PRINT"or press Enter for the default save":INPUT">" CMD$:IF LEFT$(CMD$,2)="S." THEN CMD$=RIGHT$(CMD$,LEN(CMD$)-2)
  140IF C$="2" THEN CMD$="LOAD "+CMD$:CLS:PROCload
  150REPEAT:D%=RND(100):PROCpreRoom:IF R%<>OLR% THEN OLR%=R%:PROCcl:PROCgtRm(R%):PROCt
  160D%=FNhighPty:IF EX%=0 AND NOT D% THEN PROCpsTxt
  170IF V%=0 AND EX%=0 AND NOT D% THEN PROCmsg(4):GOTO 190
  180IF EX%=0 AND NOT D% THEN D%=FNckMv:IF NOT D% THEN D%=FNlowPty:IF V%>0 AND NOT D% THEN PROCmsg(3)
  190CL%=0:D%=0:UNTIL EX%=1:UNTIL FNagain=FALSE
  200PRINT "Thanks for playing...":END
  210DEFPROCcl:IF Q%=1 THEN CLS
  220ENDPROC
  230DEFFNagain:LOCAL A$:PRINT "":INPUT "Another game? (Y/N)";A$:IF A$="Y" OR A$="y" THEN =TRUE ELSE =FALSE
  240DEFPROCsave:LOCAL F%,X%,N$:N$=LEFT$(MID$(CMD$,6),7):IF N$="" THEN N$="SAVE-M"
  250PRINT"Saving...":F%=OPENOUT("S."+N$):PRINT#F%,T%,R%,ENC%,CW%,Q%:FOR X%=1 TO 256:BPUT#F%,?(CTR%+X%):NEXT:IF OBJN%>0 THEN FOR X%=1 TO OBJN%*8:BPUT#F%,?(OB%+X%):NEXT
  260CLOSE#F%:PROCe:PROCsvAc:PRINT"Done.":ENDPROC
  270DEFPROCload:LOCAL F%,X%,N$:N$=LEFT$(MID$(CMD$,6),7):IF N$="" THEN N$="SAVE-M"
  280PRINT"Loading...":F%=OPENIN("S."+N$):INPUT#F%,T%,R%,ENC%,CW%,Q%:FORX%=1 TO 256:?(CTR%+X%)=BGET#F%:NEXT:IF OBJN%>0 THEN FOR X%=1 TO OBJN%*8:?(OB%+X%)=BGET#F%:NEXT
  290CLOSE#F%:PROCe:PRINT"Done.":PROCsc:ENDPROC
  300DEFPROCsc:MS$(2)="What now, Clone " + STR$(FNget(6)):ENDPROC
  310DEFPROCldSM:LOCAL N%,R%,F%:F%=OPENIN("DATA-M"):DIM MS$(18):FOR X%=1 TO 18:PRINT".";:PTR#F%=FNrdIx(X%,"IDX-M"):INPUT#F%,MS$(X%):NEXT:CLOSE#F%:ENDPROC
  320DEFPROCsvAc:LOCAL F%,X%:F%=OPENOUT("IDX-C"):FOR X%=1 TO ACH%:BPUT#F%,?(AC%+X%):NEXT:CLOSE#F%:ENDPROC
  330DEFPROCldAc(F$):LOCAL N%,R%,T%:F%=OPENIN(F$):R%=0:REPEAT:FOR X%=1TO5:N%=BGET#F%:NEXT:R%=R%+1:PRINT".";:UNTIL EOF#F%:PTR#F%=0:ACH%=R%+1
  340IF FNturn=0 THEN DIM AC% ACH%
  350CLOSE#F%:F%=OPENIN("IDX-C")
  360R%=1:REPEAT:?(AC%+R%)=BGET#F%:R%=R%+1:UNTIL EOF#F%:CLOSE#F%:ENDPROC
  370DEFPROCldOb(F$):LOCAL N%,R%,T%:F%=OPENIN(F$):R%=0:REPEAT:FOR X%=1TO8:N%=BGET#F%:NEXT:R%=R%+1:PRINT".";:UNTIL EOF#F%:PTR#F%=0:OBJN%=R%:R%=R%*8
  380IF FNturn=0 THEN DIM OB% R%
  390R%=1:REPEAT:?(OB%+R%)=BGET#F%:R%=R%+1:UNTIL EOF#F%:CLOSE#F%:ENDPROC
  400DEFPROCstOb(O%,R%):LOCAL P%,L%:O%=O%-1:P%=(O%*8)+4:?(OB%+P%)=R% DIV 256:?(OB%+P%+1)=R% MOD 256:ENDPROC
  410DEFPROClsOb(R%,MS%):LOCAL X%,O%:O%=0:IF OBJN%=0 THEN ENDPROC
  420FOR X%=1TOOBJN%:M%=FNobHr(X%,R%):IF M%>0 THEN O%=O%+1:NEXT ELSE NEXT
  430IF O%=0 AND MS%>1 THEN PRINT:ENDPROC
  440IF O%=0 AND MS%=1 THEN PROCmsg(1):PROCmsg(18):ENDPROC
  450PRINT:IF MS%>0 THEN PROCmsg(MS%):PRINT
  460FOR X%=1TOOBJN%:M%=FNobHr(X%,R%):IF M%>0 THEN PRINTCHR$(131);:PROCmsg(M%):PRINT:NEXT ELSE NEXT
  470ENDPROC
  480DEFFNobHr(O%,R%):LOCAL P%,L%:O%=O%-1:L%=FNobLn(O%+1):IF L%=R% THEN =FNobMn(O%+1) ELSE =0
  490DEFFNobLn(O%):O%=O%-1:U%=(O%*8)+4+OB%:=?(U%)*256+?(U%+1)
  500DEFFNobMn(O%):O%=O%-1:U%=(O%*8)+2+OB%:=?(U%)*256+?(U%+1)
  510DEFFNobWt(O%):O%=O%-1:U%=(O%*8)+6+OB%:=?(U%)
  520DEFFNckMv:LOCAL LB%,HB%,N%:D%=FALSE:L%=HIMEM+4:N%=?L%:IF N%=0 THEN =FALSE
  530FOR C%=1 TO (N%*3) STEP 3:IF ?(L%+C%)=V% THEN LB%=?(L%+C%+2):HB%=?(L%+C%+1):R%=HB%*256+LB%:D%=TRUE:NEXT ELSE NEXT
  540=D%
  550ENDPROC
  560DEFPROCgtRm(R%):LOCAL F%,N%,LB%,HB%,M%,D%:D%=0:IF FNon(1) AND FNon(2)=FALSE THEN D%=1:PROCmsg(13)
  570CL%=0:G%=VPOS:F%=OPENIN("DATA-R"):PTR#F%=FNrdIx(R%,"IDX-R"):N%=BGET#F%:FOR C%=1TON%:HB%=BGET#F%:LB%=BGET#F%:M%=FNcint(LB%,HB%):IFD%=0THEN PROCmsg(!M%):NEXT ELSE NEXT
  580L%=HIMEM+4:N%=BGET#F%:?L%=N%:FOR C%=1 TO 36:?(L%+C%)=0:NEXT:IF N%>0 THEN FOR C%=1 TO N%*3:?(L%+C%)=BGET#F%:NEXT
  590CLOSE#F%:IF D%=0 THEN PROCrmMsg:PROClsOb(R%,15)
  600ENDPROC
  610DEFFNcint(LB%,HB%):LOCAL T%:T%=HIMEM:?T%=LB%:?(T%+1)=HB%:?(T%+2)=0:?(T%+3)=0:=T%
  620DEFPROCgW(T%):LOCAL N%,R%,D$,RN%:R%=1
  630IF T%=1 THEN N%=OPENIN("DATA-N") ELSE IF T%=2 THEN N%=OPENIN("DATA-V") ELSE IF T%=4 THEN N%=OPENIN("DATA-A")
  640REPEAT:RN%=BGET#N%:INPUT#N%,D$:R%=R%+1:UNTIL EOF#N%:PTR#N%=0
  650IF T%=1 THEN NM%=R%:DIM N$(R%):DIM NN% R% ELSE IF T%=2 THEN VM%=R%:DIM V$(R%):DIM VN% R% ELSE IF T%=4 THEN AM%=R%:DIM A$(R%):DIM AN% R%
  660R%=1:REPEAT:RN%=BGET#N%:INPUT#N%,D$
  670IF T%=1 THEN N$(R%)=FNtU(D$):NN%?R%=RN% ELSE IF T%=2 THEN V$(R%)=FNtU(D$):VN%?R%=RN% ELSE IF T%=4 THEN A$(R%)=FNtU(D$):AN%?R%=RN%
  680R%=R%+1:PRINT".";:UNTIL EOF#N%:CLOSE#N%:ENDPROC
  690DEFPROCmsg(M%):LOCAL S%,P%,H%,M$,A%:IF M%<19 THEN M$=MS$(M%) ELSE M$=FNgm(M%)
  700IF M%=0 THEN PRINT
  710S%=1:P%=1:H%=POS:REPEAT:P%=INSTR(M$," ",S%):IF P%=0 THEN H%=H%+(LEN(M$)-S%)+1 ELSE H%=H%+(P%-S%)+1
  720IF H%>40 THEN PRINT
  730PRINT MID$(M$,S%,P%-S%);" ";:H%=POS:S%=P%+1:
  740UNTIL P%=0
  750IF POS=1 THEN VDU31,POS-1,VPOS:A%=135:C=USR(&FFF4):C=C AND &FFFF:C=C DIV &100:IF C>32 THEN VDU31,POS+1,VPOS
  760ENDPROC
  770DEFFNgm(M%):LOCAL S%,P%,E$,F%:F%=OPENIN("DATA-M"):PTR#F%=FNrdIx(M%,"IDX-M"):INPUT#F%,M$:CLOSE#F%:=M$
  780DEFFNrdIx(Re%,file$):I%=(Re%-1)*5:IND=OPENIN(file$):PTR#IND=I%:INPUT#IND,I%:CLOSE#IND:=I%
  790DEFPROCpsTxt:LOCAL WRDLEN%,C$,C%,S%,U%:PROCvars:REPEAT:PRINT:PROCmsg(2):U%=VPOS:INPUT TAB(LEN(MS$(2)),U%), CMD$:UNTIL CMD$>"":TIME=0:CMD$=FNtU(CMD$):S%=1:IF LEFT$(CMD$,2)="*C" OR LEFT$(CMD$,2)="*." THEN D%=TRUE:*CAT
  800REPEAT:WRD$=FNgW(MID$(CMD$,S%,LEN(CMD$)-S%+1)):S%=S%+LEN(WRD$)+1
  810IF V%=0 THEN V%=FNpW(WRD$,1):IF V%>0 THEN GOTO 850
  820IF N%=0 THEN N%=FNpW(WRD$,2):IF N%>0 THEN GOTO 850
  830IF AVRB%=0 THEN AVRB%=FNpW(WRD$,3):IF AVRB%>0 THEN GOTO 850
  840IF NO2%=0 THEN NO2%=FNpW(WRD$,2):IF NO2%=N% THEN NO2%=0
  850UNTIL S%>=LEN(CMD$):ENDPROC
  860DEFFNpW(T$,T%):LOCAL W%,N%,E%,F%,R%,W$,M%:W%=0:R%=1:E%=LEN(T$)
  870REPEAT:IF T%=1 THEN W$=V$(R%):M%=VM% ELSE IF T%=2 THEN W$=N$(R%):M%=NM% ELSE IF T%=3 THEN W$=A$(R%):M%=AM%
  880F%=LEN(W$):IF E%>=F% THEN IF T$=W$ AND F%>0 THEN W%=R%
  890R%=R%+1:UNTIL R%=M% OR W%>0 OR F%=0
  900IF T%=1 AND W%>0 THEN =VN%?W% ELSE IF T%=2 AND W%>0 THEN =NN%?W% ELSE IF T%=3 AND W%>0 THEN =AN%?W% ELSE =0
  910DEFFNtU(T$):LOCAL C%,P%,L%,U$:U$="":L%=LEN(T$):FOR P%=1 TO L%:C%=ASC(MID$(T$,P%,1)):IF C%>90 THEN C%=C%-32
  920U$=U$+CHR$(C%):NEXT:=U$
  930DEFFNgW(T$):LOCAL C%,C$,WRD$:C%=1
  940REPEAT:C$=MID$(T$,C%,1):WRD$=WRD$+C$:C%=C%+1:UNTIL C$=" " OR C%>LEN(T$)
  950IF RIGHT$(WRD$,1)<>" " THEN WRD$=WRD$+" " 
  960=LEFT$(WRD$,LEN(WRD$)-1)
  970DEFPROCvars:CMD$="":N%=0:NO2%=0:V%=0:AVRB%=0:OBJ%=0:WRD$="":N%=0:D%=0:ENDPROC
  980DEFPROCsetA(C%):LOCALT%:?(AC%+C%)=1:T%=1:FORX%=20TO29:IF?(AC%+X%)=0 THEN T%=0:NEXT ELSE NEXT
  990IF T%=1 THEN ?(AC%+11)=1
 1000T%=1:FORX%=30TO33:IF?(AC%+X%)=0 THEN T%=0:NEXT ELSE NEXT
 1010IF T%=1 THEN ?(AC%+17)=1
 1020T%=0:FOR X%=1TO34:T%=T%+?(AC%+T%):NEXT:IFT%=34THEN?(AC%+35)=1
 1030PROCsvAc:ENDPROC
 1040DEFPROCshAc:LOCAL X%,C%,M%:C%=0:PROCmsg(313):PRINT:FOR X%=1 TO ACH%
 1050IF ?(AC%+X%)=1 THEN M%=FNrdIx(X%,"DATA-C"):PRINTCHR$(131);:PROCmsg(M%):PRINT:C%=C%+1
 1060NEXT:IF C%=0 THEN PRINTCHR$(131);:PROCmsg(314)
 1070ENDPROC
 1080DEFPROCtake(O%):IF FNobHr(O%,R%)=0 THEN PROCmsg(14):ENDPROC
 1090IF CW%+FNobWt(O%)>ENC% THEN PROCmsg(10):ENDPROC
 1100PROCstOb(O%,PL%):PROCmsg(16):PROCt:CW%=CW%+FNobWt(O%):ENDPROC
 1110DEFPROCswap(O1%,O2%):PROCstOb(O1%,0):PROCstOb(O2%,PL%):ENDPROC
 1120DEFPROCmove(O%,R%):PROCstOb(O%,R%):ENDPROC
 1130DEFPROCdrop(O%):IF FNobHr(O%,PL%)=0:PROCmsg(8):ENDPROC
 1140PROCstOb(O%,R%):PROCmsg(16):PROCt:CW%=CW%-FNobWt(O%):ENDPROC
 1150DEFPROCinv:PROClsOb(PL%,1):ENDPROC
 1160DEFPROCobj(O%):PROCmsg(FNobMn(O%)):ENDPROC
 1170DEFPROClist(R%):PROClsOb(R%,0):ENDPROC
 1180DEFPROCgoto(RM%):R%=RM%:ENDPROC
 1190DEFPROCfind(O%):LOCAL T%:T%=FNobLn(O%):PROCgoto(T%):ENDPROC
 1200DEFPROCt:T%=T%+1:ENDPROC
 1210DEFPROCenc(D%):ENC%=D%:ENDPROC
 1220DEFFNon(F%):IF ?(CTR%+F%)>0 THEN =TRUE ELSE =FALSE
 1230DEFPROCinc(C%):LOCAL T%:T%=FNget(C%):IF T%<256 THEN T%=T%+1:PROCset(C%,T%)
 1240ENDPROC
 1250DEFPROCdec(C%):LOCAL T%:T%=FNget(C%):IF T%>0 THEN T%=T%-1:PROCset(C%,T%)
 1260ENDPROC
 1270DEFPROChold(T%):LOCAL FT%:FT%=TIME+T%:REPEAT:UNTIL TIME>=FT%:ENDPROC
 1280DEFPROCset(C%,T%):?(CTR%+C%)=T%:ENDPROC
 1290DEFPROCon(C%):?(CTR%+C%)=1:ENDPROC
 1300DEFPROCoff(C%):?(CTR%+C%)=0:ENDPROC
 1310DEFFNget(C%):=?(CTR%+C%)
 1320DEFPROCcls(S%):Q%=S%:PROCe:PROCmsg(16):ENDPROC
 1330DEFFNhere(O%):IF FNobHr(O%,R%)=0 THEN =FALSE ELSE =TRUE
 1340DEFFNinInv(O%):IF FNobHr(O%,PL%)=0 THEN =FALSE ELSE =TRUE
 1350DEFFNavail(O%)=FNhere(O%) OR FNinInv(O%)
 1360DEFFNrn(N%):LOCAL R%:R%=RND(N%):=R%
 1370DEFPROCe:D%=1:ENDPROC
 1380DEFPROCexit:EX%=1:ENDPROC
 1390DEFFNturn:=T%
 1400DEFPROCwait:PRINT:PRINT"Please press a key.";:REPEAT UNTIL INKEY(0)<>-1:ENDPROC
