 2170IF R%=22 THEN IF NOT FNon(13) AND FNget(22)=22 THEN PROCmsg(91)
 2180IF R%=27 THEN IF FNget(22)=27 THEN PROCmsg(90)
 2190IF R%=28 THEN IF FNget(22)=22 THEN PROCmsg(90)
 2200IF R%=39 THEN IF FNget(26)=1 THEN PROCmsg(165)
