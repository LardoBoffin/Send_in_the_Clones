 1680IF V%=3 AND R%=21 THEN R%=22:=TRUE
 1690IF V%=4 AND R%=21 THEN R%=17:=TRUE
 1700=FALSE
 1710DEFFNrm22
 1720IF V%=29 AND N%=3 THEN IF FNavail(3) THEN IF FNget(4)=3 THEN PROCset(21,2):PROCmsg(138):PROCmove(3,22):=TRUE
 1730IF V%=29 AND N%=3 THEN IF FNavail(3) THEN IF FNget(4)<>3 THEN PROCon(21):PROCmsg(139):PROCmove(3,22):=TRUE
 1740IF NOT FNon(13) AND V%=22 AND N%=3 AND FNavail(3) AND NOT FNon(21) THEN PROCmsg(137):PROCsetA(16):PROCmove(3,0):=TRUE
 1750IF NOT FNon(13) AND V%=22 AND N%=3 AND FNavail(3) AND FNget(5)=4 AND FNget(21)=1 THEN PROCmsg(140):PROCsetA(16):PROCmove(3,0):=TRUE
 1760IF NOT FNon(13) AND V%=22 AND N%=3 AND FNavail(3) AND FNget(5)=4 AND FNget(21)=2 THEN PROCmsg(135):PROCon(13):PROCstg(3):PROCset(22,22):PROCmove(3,0):=TRUE
 1770IF NOT FNon(13) AND V%=22 AND N%=3 AND FNget(5)<4 THEN PROCmsg(136):PROCoff(13):=TRUE
 1780IF (NOT FNon(13) AND V%=3) OR (FNon(13) AND V%=3 AND FNget(22)=27) THEN PROCmsg(94):PROCsetA(9):PRINT:PROCdie:=TRUE
 1790IF FNon(13) AND V%=3 AND FNget(22)=22 THEN PROCgoto(49):=TRUE
 1800=FALSE
 1810DEFPROCrndMsg:LOCAL R%:PROCmsg(19):R%=FNrn(10):PROCmsg(R%+19):PROCsetA(19+R%):PROCmsg(72):PRINT:PRINT:ENDPROC
 1820DEFPROCmvAll
 1830FOR X%=1 TO OBJN%:IF FNhere(X%) THEN PROCmove(X%,FNrn(4)+14):NEXT ELSE NEXT
 1840ENDPROC
 1850DEFPROCdie
 1860PROCinc(6):IF FNget(6)>8 THEN PROCmsg(76):PRINT:EX%=1:ENDPROC
 1870PROCsc
